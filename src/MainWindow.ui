  <property name="styleSheet">
   <string notr="true">
QMainWindow,
QWidget#centralWidget {
    background-color: #131c26;
    color: #d7e4ee;
}

QFrame#headerWidget {
    background-color: #131c26;
    border-bottom: 1px solid #223140;
}

QLabel#titleLabel {
    color: #d7e4ee;
    font-size: 18px;
    font-weight: 600;
}

QLabel#subtitleLabel {
    color: #8aa0b0;
    font-size: 12px;
}

QPushButton#testTabButton,
QPushButton#calibrationTabButton,
QPushButton#developerTabButton {
    min-height: 36px;
    max-height: 36px;
    min-width: 110px;
    background-color: #1b2630;
    border: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    color: #8aa0b0;
    font-size: 14px;
    font-weight: 600;
    padding: 0 18px;
    text-align: center;
}

QPushButton#testTabButton:hover,
QPushButton#calibrationTabButton:hover,
QPushButton#developerTabButton:hover {
    background-color: #253544;
    color: #d7e4ee;
}

QPushButton#testTabButton:checked,
QPushButton#calibrationTabButton:checked,
QPushButton#developerTabButton:checked {
    background-color: #0069f1;
    color: #ffffff;
}

QFrame#sidebarPanel {
    background: transparent;
    border: none;
}

QFrame#contentPanel,
QFrame#serialFrame,
QFrame#testFrame,
QFrame#calibrationFrame,
QFrame#developerFrame {
    background-color: #18242e;
    border: 1px solid #223140;
    border-radius: 10px;
}

QLabel#testTitleIcon {
    background: transparent;
    border: none;
}

QLabel#serialTitle,
QLabel#testTitle,
QLabel#calibrationTitle,
QLabel#developerTitle {
    color: #d7e4ee;
    font-size: 14px;
    font-weight: 600;
}

QComboBox#portCombo {
    min-height: 40px;
    background-color: #1e2c38;
    border: 1px solid #223140;
    border-radius: 8px;
    padding: 2px 8px;
    color: #d7e4ee;
    combobox-popup: 0;
}

QComboBox#portCombo::drop-down {
    border: none;
    width: 24px;
}

QComboBox#portCombo QAbstractItemView {
    background-color: #18242e;
    color: #d7e4ee;
    selection-background-color: #1e2c38;
    selection-color: #d7e4ee;
    border: 1px solid #223140;
    border-radius: 8px;
    outline: none;
    padding: 4px 0;
}

QComboBox#portCombo QAbstractItemView::item {
    min-height: 40px;
    padding: 10px 14px;
}

QPushButton#connectButton,
QPushButton#startButton,
QPushButton#stopButton {
    min-height: 40px;
    background-color: #1e2c38;
    border: none;
    border-radius: 8px;
    padding: 4px 14px;
    color: #ffffff;
    font-weight: 600;
    text-align: left;
}

QPushButton#connectButton {
    background-color: #24313c;
    color: #8aa0b0;
    text-align: center;
}

QPushButton#connectButton[connectable="true"] {
    background-color: #1e2c38;
    color: #ffffff;
}

QPushButton#connectButton[connectable="true"]:hover {
    background-color: #2d4152;
    color: #ffffff;
}

QPushButton#connectButton[connected="true"] {
    background-color: #0a7a45;
    color: #ffffff;
}

QPushButton#connectButton[connected="true"]:hover {
    background-color: #0c8d50;
    color: #ffffff;
}

QPushButton#startButton {
    background-color: #0069f1;
}

QPushButton#startButton:hover {
    background-color: #1a7af4;
}

QPushButton#stopButton {
    background-color: #7f2934;
}

QPushButton#stopButton:hover {
    background-color: #93303d;
}

QPushButton#startButton:disabled,
QPushButton#stopButton:disabled {
    background-color: #24313c;
    color: #8aa0b0;
}

QFrame#errorToast {
    background-color: #2a1f24;
    border: 1px solid #7f2934;
    border-radius: 8px;
}

QLabel#errorToastLabel {
    color: #d7e4ee;
    font-size: 13px;
}

QPushButton#errorToastCloseButton {
    min-height: 24px;
    max-height: 24px;
    min-width: 24px;
    max-width: 24px;
    background: transparent;
    border: none;
    border-radius: 4px;
    color: #8aa0b0;
    font-weight: 600;
    padding: 0;
    text-align: center;
}

QPushButton#errorToastCloseButton:hover {
    background-color: #3a2a30;
    color: #d7e4ee;
}

QScrollArea#sidebarScrollArea,
QScrollArea#contentScrollArea {
    background: transparent;
    border: none;
}

QScrollArea#sidebarScrollArea &gt; QWidget,
QScrollArea#contentScrollArea &gt; QWidget,
QWidget#sidebarScrollContents,
QWidget#contentScrollContents,
QStackedWidget#contentStack,
QWidget#testPage,
QWidget#calibrationPage,
QWidget#developerPage {
    background: transparent;
    border: none;
}

QLabel#calibrationPlaceholderLabel,
QLabel#developerPlaceholderLabel {
    color: #8aa0b0;
    font-size: 18px;
    font-weight: 600;
}

QFrame#footerWidget {
    background-color: #131c26;
    border-top: 1px solid #223140;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 4px 2px;
}

QScrollBar::handle:vertical {
    background: #34495a;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #486276;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
    border: none;
    height: 0;
}
